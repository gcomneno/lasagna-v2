# Normalizzazione EOL
* text=auto

# Python: diff decente
*.py diff=python

# File binari del codec
*.lsg2 -text binary

# CSV: li consideriamo testo (se/quando li whitelisti)
*.csv text

# Non tentare merge "furbi" su file di lock, se li userai
poetry.lock merge=union
Pipfile.lock merge=union

# M2.2B protocol documents preserve byte-frozen EOF layout.
docs/rate-distortion-design.md whitespace=-blank-at-eof
docs/protocol-history/m2-2b/v*/rate-distortion-design.md whitespace=-blank-at-eof
